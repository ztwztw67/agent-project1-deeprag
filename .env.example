# ========== 应用配置 ==========
APP_NAME=agent-project1
APP_ENV=development
DEBUG=true

# ========== 数据库（暂时不用，先写上占位） ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=agent_db

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== JWT 认证 ==========
# ⚠️ 生产环境必须换成随机字符串！
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440

# ========== LLM API ==========
# 填入你的 API Key（DeepSeek / OpenAI 皆可）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro      # 或 deepseek-chat（便宜但推理弱）
LLM_REASONING_EFFORT=high      # v4-pro 专用：low / medium / high
LLM_THINKING=enabled           # v4-pro 专用：enabled / disabled
